# $(find my_slam)/rviz/nav2.rviz
Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 555
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.7
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      Name: Map
      Topic: /map
      Unreliable: false
      Use Timestamp: false
      Value: true
    
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
    
    - Alpha: 1
      Class: rviz/LaserScan
      Color: 255; 255; 255
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Name: LaserScan
      Topic: /scan
      Unreliable: false
      Use Fixed Frame: true
      
    - Alpha: 1
      Class: rviz/Path
      Color: 255; 0; 0
      Enabled: true
      Name: Global Plan
      Topic: /move_base/NavfnROS/plan
      Line Style: Lines
      Line Width: 0.03
      
    - Alpha: 1
      Class: rviz/Path
      Color: 0; 255; 0
      Enabled: true
      Name: Local Plan
      Topic: /move_base/DWAPlannerROS/local_plan
      Line Style: Lines
      Line Width: 0.03

    - Class: rviz/Map
      Name: Local Costmap
      Topic: /move_base/local_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.6
      Draw Behind: false
      Enabled: true
      Value: true

    - Class: rviz/Map
      Name: Global Costmap
      Topic: /move_base/global_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.6
      Draw Behind: false
      Enabled: true
      Value: true

  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30

  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/SetInitialPose
      Topic: /initialpose

Window Geometry:
  Height: 846
  Width: 1200
  X: 65 
  Y: 60