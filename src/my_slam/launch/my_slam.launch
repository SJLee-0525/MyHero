<?xml version="1.0"?>
<launch>
    <!-- 1) Static Transform Publisher for robot frames -->
    <node pkg="tf" type="static_transform_publisher" name="base_to_laser"
        args="0 0 0 0 0 0 base_link laser_frame 100" />
    
    <node pkg="tf" type="static_transform_publisher" name="base_footprint_to_base"
        args="0 0 0 0 0 0 base_footprint base_link 100" />

    <!-- 2) YDLidar X4 실행 -->
    <include file="$(find ydlidar_ros_driver)/launch/X4.launch" />

    <!-- 3) Hector SLAM 노드 -->
    <node pkg="hector_mapping" type="hector_mapping" name="hector_mapping" output="screen">
        <!-- 프레임 설정: map -> base_footprint -->
        <param name="map_frame" value="map" />
        <param name="base_frame" value="base_footprint" />
        <!-- odom을 사용하지 않으므로 odom_frame = base_footprint or "" 로 설정 -->
        <param name="odom_frame" value="base_footprint" />
        <param name="pub_map_odom_transform" value="true" />

        <!-- use_tf_scan_transformation: 라이다를 TF로 변환할지 여부 -->
        <param name="use_tf_scan_transformation" value="true"/>
        <!-- 초기 Pose는 별도 TF로 추정 false (필요하면 true) -->
        <param name="use_tf_pose_start_estimate" value="false"/>

        <!-- 맵 해상도/크기 -->
        <param name="map_resolution" value="0.050"/>
        <param name="map_size" value="2048"/>
        <param name="map_start_x" value="0.5"/>
        <param name="map_start_y" value="0.5"/>

        <!-- 라이다 Scan 토픽 -->
        <param name="scan_topic" value="/scan"/>
    </node>

    <!-- 4) RViz 실행 (선택적) -->
    <!-- <node pkg="rviz" type="rviz" name="rviz"
          args="-d $(find my_slam)/rviz/slam.rviz" respawn="true"/> -->
</launch>