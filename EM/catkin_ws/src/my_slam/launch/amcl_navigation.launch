<?xml version="1.0"?>
<launch>
  <!-- 정적 맵 서버: SLAM으로 생성한 정적 맵 파일 로드 -->
  <node pkg="map_server" type="map_server" name="map_server" args="$(find my_slam)/maps/map.yaml" />

  <!-- AMCL 노드: 정적 맵을 이용한 로봇 위치 추정 -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <!-- AMCL 파라미터 파일 설정 (예: global_frame, robot_base_frame, laser 관련 파라미터) -->
    <rosparam file="$(find my_slam)/config/amcl_params.yaml" command="load" />
  </node>

  <!-- move_base 노드: 글로벌/로컬 코스트맵 및 플래너 관련 파라미터 로드 -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find my_slam)/config/move_base/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find my_slam)/config/move_base/amcl_global_costmap_params.yaml" command="load" />
    <rosparam file="$(find my_slam)/config/move_base/amcl_local_costmap_params.yaml" command="load" />
    <rosparam file="$(find my_slam)/config/move_base/dwa_local_planner.yaml" command="load" />

    <rosparam file="$(find my_slam)/config/move_base/recovery_params.yaml" command="load" />
    <param name="recovery_behavior_enabled" value="true" />
    <param name="clearing_rotation_allowed" value="false" />

    <!-- move_base 기본 파라미터 -->
    <param name="controller_frequency" value="10.0" />
    <param name="controller_patience" value="2.0" />
    <param name="shutdown_costmaps" value="false" />
    <param name="base_global_planner" value="navfn/NavfnROS"/>
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"/>
  </node>

  <!-- 모터 컨트롤러 노드 -->
  <include file="$(find robot_motor_controller)/launch/motor_controller.launch" />

  <!-- LiDAR 및 TF 관련 노드 실행 (my_slam.launch에서 LiDAR 관련 부분만 포함) -->
  <!-- TF: base_link와 laser_frame, base_footprint와 base_link 사이의 static transform -->
  <node pkg="tf" type="static_transform_publisher" name="base_to_laser"
        args="0 0 0 0 0 0 base_link laser_frame 100" />
  <node pkg="tf" type="static_transform_publisher" name="base_footprint_to_base"
        args="0 0 0 0 0 0 base_footprint base_link 100" />

  <!-- LiDAR 센서 노드: YDLidar X4 실행 -->
  <include file="$(find ydlidar_ros_driver)/launch/X4.launch" />

  <!-- 조이스틱 노드 -->
  <node pkg="joy" type="joy_node" name="joy_node">
    <param name="dev" value="/dev/input/js0"/>
    <param name="deadzone" value="0.12"/>
  </node>

  <!-- 조이스틱을 cmd_vel로 변환하는 노드 -->
  <node pkg="robot_motor_controller" type="joy_teleop.py" name="joy_teleop" output="screen">
    <param name="axis_linear" value="1"/>
    <param name="axis_angular" value="3"/>
    <param name="scale_linear" value="0.4"/>
    <param name="scale_angular" value="1.0"/>
    <param name="mode_button" value="0"/>
    <param name="stop_button" value="1"/>
    <param name="priority" value="true"/>
  </node>

  <!-- RViz 실행 (네비게이션 상태 시각화) -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find my_slam)/rviz/nav2.rviz"
        respawn="true"
        output="screen"/>
</launch>
