<?xml version="1.0"?>
<robot name="my_robot">
   <!-- 예시 색상 정의 -->
   <material name="blue">
       <color rgba="0 0.5 1.0 1.0"/>
   </material>
   <material name="black">
       <color rgba="0 0 0 1"/>
   </material>
   <material name="red">
       <color rgba="1 0 0 1"/>
   </material>

   <!-- 바닥 기준 프레임 (base_footprint) -->
   <link name="base_footprint"/>

   <!-- 실제 로봇 본체 (base_link) -->
   <link name="base_link">
       <visual>
           <geometry>
               <box size="0.30 0.12 0.15"/>
           </geometry>
           <material name="blue" />
       </visual>
   </link>

   <!-- base_footprint -> base_link 고정 조인트 -->
   <joint name="base_joint" type="fixed">
       <parent link="base_footprint"/>
       <child link="base_link"/>
       <!-- Z방향으로 0.075m 위에 로봇의 중심 박스가 있다고 가정 -->
       <origin xyz="0 0 0.075" rpy="0 0 0"/>
   </joint>

   <!-- 라이다 링크(laser_frame) -->
   <link name="laser_frame">
       <visual>
           <geometry>
               <cylinder radius="0.03" length="0.03"/>
           </geometry>
           <material name="black"/>
       </visual>
   </link>

   <!-- base_link -> laser_frame 고정 조인트 -->
   <joint name="laser_joint" type="fixed">
       <parent link="base_link"/>
       <child link="laser_frame"/>
       <!-- base_link 기준으로 z=0.125m 위치 -->
       <origin xyz="0 0 0.125" rpy="0 0 0"/>
   </joint>

   <!-- 조향 링크(steering_link) -->
   <link name="steering_link">
       <visual>
           <geometry>
               <box size="0.02 0.12 0.02"/>
           </geometry>
           <material name="red"/>
       </visual>
   </link>

   <joint name="steering_joint" type="revolute">
       <parent link="base_link"/>
       <child link="steering_link"/>
       <origin xyz="0.12 0 0"/>
       <axis xyz="0 0 1"/>
       <limit lower="-0.785" upper="0.785" effort="10" velocity="1"/>
   </joint>

   <!-- 앞바퀴(좌/우) -->
   <link name="front_left_wheel">
       <visual>
           <geometry>
               <cylinder radius="0.035" length="0.02"/>
           </geometry>
           <material name="black"/>
       </visual>
   </link>

   <joint name="front_left_wheel_joint" type="continuous">
       <parent link="steering_link"/>
       <child link="front_left_wheel"/>
       <origin xyz="0 0.06 -0.035" rpy="1.5708 0 0"/>
       <axis xyz="0 0 1"/>
   </joint>

   <link name="front_right_wheel">
       <visual>
           <geometry>
               <cylinder radius="0.035" length="0.02"/>
           </geometry>
           <material name="black"/>
       </visual>
   </link>

   <joint name="front_right_wheel_joint" type="continuous">
       <parent link="steering_link"/>
       <child link="front_right_wheel"/>
       <origin xyz="0 -0.06 -0.035" rpy="1.5708 0 0"/>
       <axis xyz="0 0 1"/>
   </joint>

   <!-- 뒷바퀴 축 -->
   <link name="rear_wheel_axis">
       <visual>
           <geometry>
               <box size="0.02 0.12 0.02"/>
           </geometry>
           <material name="red"/>
       </visual>
   </link>

   <joint name="rear_axis_joint" type="fixed">
       <parent link="base_link"/>
       <child link="rear_wheel_axis"/>
       <origin xyz="-0.12 0 0"/>
   </joint>

   <!-- 뒷바퀴(좌/우) -->
   <link name="rear_left_wheel">
       <visual>
           <geometry>
               <cylinder radius="0.035" length="0.02"/>
           </geometry>
           <material name="black"/>
       </visual>
   </link>

   <joint name="rear_left_wheel_joint" type="continuous">
       <parent link="rear_wheel_axis"/>
       <child link="rear_left_wheel"/>
       <origin xyz="0 0.06 -0.035" rpy="1.5708 0 0"/>
       <axis xyz="0 0 1"/>
   </joint>

   <link name="rear_right_wheel">
       <visual>
           <geometry>
               <cylinder radius="0.035" length="0.02"/>
           </geometry>
           <material name="black"/>
       </visual>
   </link>

   <joint name="rear_right_wheel_joint" type="continuous">
       <parent link="rear_wheel_axis"/>
       <child link="rear_right_wheel"/>
       <origin xyz="0 -0.06 -0.035" rpy="1.5708 0 0"/>
       <axis xyz="0 0 1"/>
   </joint>
</robot>

