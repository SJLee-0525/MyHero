Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/ToolProperties
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views
  - Class: rviz/Time
    Name: Time

Visualization Manager:
  Name: root
  Class: ""
  Displays:
    - Name: Grid
      Class: rviz/Grid
      Enabled: true
      Value: true
      Alpha: 0.5
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Color: 160; 160; 160

    - Name: RobotModel
      Class: rviz/RobotModel
      Enabled: true
      Robot Description: robot_description
      Collision Enabled: false
      Visual Enabled: true
      TF Prefix: ""
      Update Interval: 0

    - Name: TF
      Class: rviz/TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Frame Timeout: 15

    - Name: Map
      Class: rviz/Map
      Enabled: true
      Topic: /map
      Color Scheme: map
      Alpha: 0.7
      Draw Behind: false
      Unreliable: false
      Use Timestamp: false

    - Name: LaserScan
      Class: rviz/LaserScan
      Enabled: true
      Topic: /scan
      Color Transformer: Intensity
      Style: Points
      Size (Pixels): 3
      Alpha: 1.0
      Decay Time: 0
      Autocompute Intensity Bounds: true
      Min Intensity: 0
      Max Intensity: 4096
      Queue Size: 10

    - Name: Global Plan
      Class: rviz/Path
      Topic: /move_base/NavfnROS/plan
      Enabled: true
      Color: 255; 0; 0        # 빨간색
      Alpha: 1.0
      Line Style: Lines
      Line Width: 0.03

    - Name: Local Plan
      Class: rviz/Path
      Topic: /move_base/DWAPlannerROS/local_plan
      Enabled: true
      Color: 0; 255; 0        # 녹색
      Alpha: 1.0
      Line Style: Lines
      Line Width: 0.03

    - Name: Global Costmap
      Class: rviz/Map
      Enabled: true
      Topic: /move_base/global_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.6
      Draw Behind: false

    - Name: Local Costmap
      Class: rviz/Map
      Enabled: true
      Topic: /move_base/local_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.6
      Draw Behind: false

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
    Default Light: true

  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Topic: /clicked_point

  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.785398
      Yaw: 0.785398
      Focal Shape Size: 0.05

Window Geometry:
  Displays:
    collapsed: false
  Height: 846
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
